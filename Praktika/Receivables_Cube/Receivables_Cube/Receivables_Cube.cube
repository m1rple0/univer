  <MdxScripts>
    <MdxScript dwd:design-time-name="b33881fb-03c0-4e75-abe0-3a218516eda6">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
Команда CALCULATE контролирует агрегатное выражение конечных ячеек в кубе.
Удаление или изменение команды CALCULATE приведет к изменению данных, содержащихся в кубе.
Эту команду следует изменять только в том случае, если способ статистической обработки куба задается вручную.
*/
CALCULATE;  
CREATE MEMBER CURRENTCUBE.[Measures].[Процент оплаты]
 AS IIF(
    [Measures].[Сумма задолженности] = 0,
    NULL,
    [Measures].[Сумма оплаты] / [Measures].[Сумма задолженности]
), 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Аналитика' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Debt'  ;  
CREATE MEMBER CURRENTCUBE.[Measures].[Процент неоплаченной задолженности]
 AS IIF(
    [Measures].[Сумма задолженности] = 0,
    NULL,
    [Measures].[Остаток долга] / [Measures].[Сумма задолженности]
), 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Аналитика' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Debt'  ;   
CREATE MEMBER CURRENTCUBE.[Measures].[Остаток долга]
 AS [Measures].[Сумма задолженности] - [Measures].[Сумма оплаты], 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Debt'; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>